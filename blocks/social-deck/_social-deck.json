{
  "definitions": [
    {
      "title": "Social Deck",
      "id": "social-deck",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Social Deck",
              "model": "social-deck",
              "filter": "social-deck"
            }
          }
        }
      }
    },
    {
      "title": "Social Card",
      "id": "social-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Social Card",
              "model": "social-card"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "social-deck",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "classes",
          "label": "Auto-scroll",
          "description": "Automatically rotate the deck at a fixed interval. Requires min. 2 cards and max. 12 cards. Strip: a flat row of cards with previous and next buttons instead of the arc (no auto-scroll).",
          "value": "",
          "options": [
            {
              "name": "Off",
              "value": ""
            },
            {
              "name": "Auto-scroll 3s",
              "value": "autoplay-3s"
            },
            {
              "name": "Auto-scroll 5s",
              "value": "autoplay"
            },
            {
              "name": "Auto-scroll 8s",
              "value": "autoplay-8s"
            },
            {
              "name": "Strip (flat row)",
              "value": "strip"
            }
          ]
        }
      ]
    },
    {
      "id": "social-card",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Card Image",
          "multi": false,
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "ALT Text",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "link",
          "label": "Social Link URL",
          "placeholder": "https://www.instagram.com/p/...",
          "required": true,
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^https?://.+",
            "customErrorMsg": "Enter an external URL starting with http:// or https://"
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "caption",
          "label": "Caption",
          "description": "Max. 60 character",
          "value": "",
          "valueFormat": "regexp",
          "validation": {
            "maxLength": 60,
            "regExp": "^[\\s\\S]{0,60}$",
            "customErrorMsg": "Caption must be 60 characters or fewer."
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "social-deck",
      "components": [
        "social-card"
      ]
    }
  ]
}
